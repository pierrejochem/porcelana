{
  "name": "@porcelana/icons",
  "version": "0.1.0",
  "description": "51 tree-shakable stroke icons for React on a 24px grid, accessible by default (decorative or labelled), from the Porcelana design system.",
  "keywords": [
    "react",
    "icons",
    "react-icons",
    "svg-icons",
    "icon-set",
    "stroke-icons",
    "tree-shakable",
    "accessible",
    "typescript",
    "design-system",
    "porcelana"
  ],
  "author": {
    "name": "Pierre Jochem",
    "url": "https://github.com/pierrejochem"
  },
  "license": "MIT",
  "homepage": "https://pierrejochem.github.io/porcelana/",
  "bugs": {
    "url": "https://github.com/pierrejochem/porcelana/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pierrejochem/porcelana.git",
    "directory": "packages/icons"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack ."
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
