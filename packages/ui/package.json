{
  "name": "@porcelana/ui",
  "version": "0.1.0",
  "description": "Accessible, mobile-ready React component library on Radix UI primitives: 35+ TypeScript components with light/night themes, data table, date picker, combobox, dialogs and bottom sheets.",
  "keywords": [
    "react",
    "react-components",
    "component-library",
    "ui-kit",
    "design-system",
    "radix-ui",
    "radix",
    "accessible",
    "accessibility",
    "a11y",
    "wcag",
    "typescript",
    "mobile-first",
    "touch",
    "dark-mode",
    "theme",
    "data-table",
    "datepicker",
    "combobox",
    "dialog",
    "bottom-sheet",
    "slider",
    "toast",
    "css-variables",
    "porcelana"
  ],
  "author": {
    "name": "Pierre Jochem",
    "url": "https://github.com/pierrejochem"
  },
  "license": "MIT",
  "homepage": "https://pierrejochem.github.io/porcelana/",
  "bugs": {
    "url": "https://github.com/pierrejochem/porcelana/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pierrejochem/porcelana.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack . --exclude-entrypoints styles.css",
    "preview": "node preview/build.mjs --serve",
    "preview:build": "node preview/build.mjs"
  },
  "dependencies": {
    "@porcelana/icons": "workspace:^",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.14.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
